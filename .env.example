# PostgreSQL 17 local development configuration
# Generate a secure local password for development (e.g. openssl rand -hex 16)
POSTGRES_PASSWORD=
POSTGRES_PORT=5435
POSTGRES_DB=tribuna_santo
POSTGRES_USER=tribuna_santo
DATABASE_URL=postgresql://tribuna_santo:${POSTGRES_PASSWORD}@127.0.0.1:5435/tribuna_santo
