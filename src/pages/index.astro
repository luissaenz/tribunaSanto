---
// Portada réplica del golden master (WEB.3).
//   Banda 1: carrusel 2/3 + tendencias 1/3.
//   Banda 2: secciones A/B/C/D (3/4) + rail sticky (populares, titulares, publicidad).
//   Banda 3: rail de fotos ANTES en el DOM (en mobile aparece primero) + secciones,
//            últimas noticias y paginación.
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/ui/Carousel.astro';
import Pagination from '../components/ui/Pagination.astro';
import AdSlot from '../components/ui/AdSlot.astro';
import TrendingThumbs from '../components/home/TrendingThumbs.astro';
import SectionA from '../components/home/SectionA.astro';
import SectionB from '../components/home/SectionB.astro';
import SectionC from '../components/home/SectionC.astro';
import SectionD from '../components/home/SectionD.astro';
import PopularNews from '../components/home/PopularNews.astro';
import SectionHeadlines from '../components/home/SectionHeadlines.astro';
import PhotoStories from '../components/home/PhotoStories.astro';
import LatestGrid from '../components/home/LatestGrid.astro';
import { site } from '../presentation/site.js';
import { LATEST_PAGE_SIZE, routes } from '../presentation/routes.js';
import { pageCount } from '../presentation/pagination.js';

const { home, stories } = site;
const latestHrefs = Array.from({ length: pageCount(stories.length, LATEST_PAGE_SIZE) }, (_, i) => routes.latest(i + 1));
---

<BaseLayout
  home={true}
  editionInstant={site.editionInstant}
  current="home"
  title="Tribuna Santo — Diario deportivo de San Martín de Tucumán"
  description="Web demo de Tribuna Santo: medio deportivo dedicado a San Martín de Tucumán. Contenido ficticio de demostración."
>
  <section class="relative mb-8 lg:py-6 lg:max-w-7xl lg:mx-auto lg:px-4" aria-label="Destacadas">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <Carousel stories={home.heroSlides} variant="home" label="Notas destacadas" />
      </div>
      <TrendingThumbs stories={home.trending} />
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-3">
        <SectionA sectionId={home.band2.a.sectionId} stories={home.band2.a.stories} slot="band2" />
        <SectionB sectionId={home.band2.b.sectionId} stories={home.band2.b.stories} />
        <SectionC sectionId={home.band2.c.sectionId} stories={home.band2.c.stories} />
        <SectionD sectionId={home.band2.d.sectionId} stories={home.band2.d.stories} />
      </div>
      <aside class="relative pb-6" aria-label="Populares y titulares">
        <div data-block="home-rail" class="space-y-8 sticky top-16">
          <PopularNews stories={home.popular} />
          <SectionHeadlines sectionId={home.sidebarSection.sectionId} stories={home.sidebarSection.stories} />
          <AdSlot block="home-ad" tone="gray-200" />
        </div>
      </aside>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <aside class="relative pb-6" aria-label="Fotos">
        <div data-block="photos-rail" class="sticky top-16">
          <PhotoStories stories={home.photos} />
        </div>
      </aside>
      <div class="lg:col-span-3 pb-8">
        <SectionA sectionId={home.band3[0].sectionId} stories={home.band3[0].stories} slot="band3a" />
        <SectionA sectionId={home.band3[1].sectionId} stories={home.band3[1].stories} slot="band3b" />
        <div>
          <LatestGrid stories={home.latest} />
          <Pagination current={1} hrefs={latestHrefs} label="Más noticias" />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
