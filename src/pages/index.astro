---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PrimaryStory from '../components/PrimaryStory.astro';
import StoryCard from '../components/StoryCard.astro';
import LatestNews from '../components/LatestNews.astro';
import SportsSidebar from '../components/SportsSidebar.astro';
import { demoStories } from '../data/demo-articles.js';

const leadStory = demoStories.find((story) => story.presentation.role === 'lead');
const secondaryStories = demoStories.filter((story) => story.presentation.role === 'secondary');
const latestStories = demoStories.filter((story) => story.presentation.role === 'latest');

if (!leadStory) {
  throw new Error('WEB.1 demo requires exactly one lead story');
}
---

<EditorialLayout
  home={true}
  title="Tribuna Santo — Diario deportivo de San Martín de Tucumán"
  description="Primer medio deportivo digital autónomo dedicado a la cobertura integral de San Martín de Tucumán."
>
  <main class="container homepage-main">
    <div class="editorial-grid">
      <section id="san-martin" class="primary-column" aria-label="Noticias destacadas">
        <PrimaryStory story={leadStory} />

        <div class="secondary-section-header">
          <h2 class="section-title">Más noticias del Santo</h2>
        </div>

        <div class="secondary-grid">
          {secondaryStories.map((story) => (
            <StoryCard story={story} />
          ))}
        </div>
      </section>

      <div class="sidebar-column">
        <section id="actualidad" class="latest-section" aria-label="Últimas noticias">
          <LatestNews stories={latestStories} />
        </section>

        <aside id="club" class="sports-section" aria-label="Información deportiva">
          <SportsSidebar />
        </aside>
      </div>
    </div>
  </main>
</EditorialLayout>

<style>
  .homepage-main {
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }

  .editorial-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .secondary-section-header {
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: 1.25rem;
    padding-bottom: 0.35rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Tablet */
  @media (min-width: 48rem) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 72rem) {
    .editorial-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }

    .secondary-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
