---
import BaseLayout from '../layouts/BaseLayout.astro';
import RailLayout from '../components/layout/RailLayout.astro';
import LeadStory from '../components/home/LeadStory.astro';
import TrendingList from '../components/home/TrendingList.astro';
import SectionBlock from '../components/home/SectionBlock.astro';
import LatestGrid from '../components/home/LatestGrid.astro';
import EditorPicks from '../components/rail/EditorPicks.astro';
import CompactList from '../components/rail/CompactList.astro';
import VisualStories from '../components/rail/VisualStories.astro';
import FutureSlot from '../components/rail/FutureSlot.astro';
import Pagination from '../components/listing/Pagination.astro';
import { site } from '../presentation/site.js';
import { futureSlots } from '../presentation/future-modules.js';
import { storiesWithTopic } from '../presentation/queries.js';
import { LATEST_PAGE_SIZE, routes } from '../presentation/routes.js';

const { home, stories } = site;
const agenda = storiesWithTopic(stories, 'agenda').slice(0, 4);
const latestPages = Math.ceil(stories.length / LATEST_PAGE_SIZE);
const latestHrefs = Array.from({ length: latestPages }, (_, i) => routes.latest(i + 1));
---

<BaseLayout
  home={true}
  editionInstant={site.editionInstant}
  current="home"
  title="Tribuna Santo — Diario deportivo de San Martín de Tucumán"
  description="Primer medio deportivo digital autónomo dedicado a la cobertura integral de San Martín de Tucumán."
>
  <div class="container home">
    <div class="home__top">
      <LeadStory story={home.lead} />
      <TrendingList title="En agenda" stories={home.trending} />
    </div>

    <RailLayout railLabel="Recomendadas y datos deportivos">
      {home.primaryBand.map((block) => <SectionBlock block={block} />)}
      <Fragment slot="rail">
        <EditorPicks stories={home.picks} />
        <FutureSlot spec={futureSlots.nextMatch} />
        <FutureSlot spec={futureSlots.standings} />
        <CompactList title="Agenda" id="agenda-title" href={routes.topic('agenda')} stories={agenda} />
      </Fragment>
    </RailLayout>

    <RailLayout railFirst railLabel="Historias visuales y gráficos">
      <Fragment slot="rail">
        <VisualStories stories={home.visual} />
        <FutureSlot spec={futureSlots.matchGraphic} />
        <FutureSlot spec={futureSlots.squadMetrics} />
      </Fragment>
      {home.secondaryBand.map((block) => <SectionBlock block={block} />)}
      <LatestGrid stories={home.latest}>
        <Pagination current={1} hrefs={latestHrefs} label="Más noticias" />
      </LatestGrid>
    </RailLayout>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: var(--space-5);
  }

  .home > :global(* + *) {
    margin-top: var(--space-8);
  }

  .home__top {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 64rem) {
    .home__top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
</style>
