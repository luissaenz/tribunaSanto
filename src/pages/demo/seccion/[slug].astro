---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/chrome/Breadcrumb.astro';
import RailLayout from '../../../components/layout/RailLayout.astro';
import ListingHeader from '../../../components/listing/ListingHeader.astro';
import ListingFeature from '../../../components/listing/ListingFeature.astro';
import RiverList from '../../../components/listing/RiverList.astro';
import StandardRail from '../../../components/rail/StandardRail.astro';
import { site } from '../../../presentation/site.js';
import { sections, type Section } from '../../../presentation/taxonomy.js';
import { storiesInSection } from '../../../presentation/queries.js';

export function getStaticPaths() {
  return sections
    .filter((section) => storiesInSection(site.stories, section.id).length > 0)
    .map((section) => ({ params: { slug: section.slug }, props: { section } }));
}

interface Props {
  section: Section;
}

const { section } = Astro.props;
const [feature, ...rest] = storiesInSection(site.stories, section.id);
---

<BaseLayout
  current={section.id}
  title={`${section.label} — Tribuna Santo`}
  description={section.description}
  editionInstant={site.editionInstant}
>
  <Breadcrumb items={[{ label: section.label }]} />
  <div class="container listing-page">
    <RailLayout railLabel="Más noticias">
      <ListingHeader title={section.label} count={rest.length + 1} description={section.description} kicker="Sección" />
      <ListingFeature story={feature} />
      <RiverList stories={rest} title={`Más de ${section.label}`} />
      <Fragment slot="rail">
        <StandardRail stories={site.stories} currentSection={section.id} />
      </Fragment>
    </RailLayout>
  </div>
</BaseLayout>

<style>
  .listing-page {
    padding-top: var(--space-6);
  }

  .listing-page :global(.rail-layout__main > * + *) {
    margin-top: var(--space-6);
  }
</style>
