---
// Acerca (golden master "about"): hero, misión, cifras, equipo, historia, reconocimientos y llamados.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingHero from '../../components/institutional/LandingHero.astro';
import Mission from '../../components/institutional/Mission.astro';
import StatsBand from '../../components/institutional/StatsBand.astro';
import TeamGrid from '../../components/institutional/TeamGrid.astro';
import Timeline from '../../components/institutional/Timeline.astro';
import Awards from '../../components/institutional/Awards.astro';
import CtaSplit from '../../components/institutional/CtaSplit.astro';
import { site } from '../../presentation/site.js';
import { about } from '../../data/demo-institutional.js';
---

<BaseLayout title="Acerca de Tribuna Santo" description="Quiénes somos: la web demo de Tribuna Santo (contenido ficticio)." editionInstant={site.editionInstant}>
  <LandingHero hero={about.hero} />
  <div class="max-w-7xl mx-auto px-4 py-12">
    <Mission />
    <StatsBand />
    <TeamGrid />
    <Timeline />
    <Awards />
    <CtaSplit />
  </div>
</BaseLayout>
