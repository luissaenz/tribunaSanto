---
// Últimas (familia listing del golden master): título como H1 (D3) + río (9 por página) + paginación + sidebar.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import RiverList from '../../../components/listing/RiverList.astro';
import StandardSidebar from '../../../components/sidebar/StandardSidebar.astro';
import { site } from '../../../presentation/site.js';
import { routes } from '../../../presentation/routes.js';
import { PAGE_SIZE, pageCount, paginate } from '../../../presentation/pagination.js';
import { newestFirst } from '../../../presentation/queries.js';

export const getStaticPaths = (() =>
  Array.from({ length: pageCount(site.stories.length, PAGE_SIZE.listing) }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { page: i + 1 }
  }))) satisfies GetStaticPaths;

interface Props {
  page: number;
}

const { page } = Astro.props;
const paged = paginate(newestFirst(site.stories), PAGE_SIZE.listing, page);
const hrefs = Array.from({ length: paged.pages }, (_, i) => routes.latest(i + 1));
const title = page === 1 ? 'Últimas notas' : `Últimas notas — Página ${page}`;
---

<BaseLayout title={`${title} — Tribuna Santo`} description="Todas las notas demo de Tribuna Santo, de la más reciente a la más antigua." editionInstant={site.editionInstant}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <div class="lg:col-span-3">
        <section class="mb-10">
          <SectionHeader title={title} level={1} headingBlock="listing-title" slot="river" />
          <RiverList stories={paged.items} level={2} />
        </section>
        <Pagination current={page} hrefs={hrefs} label="Páginas de últimas notas" />
      </div>
      <StandardSidebar stories={site.stories} />
    </div>
  </div>
</BaseLayout>
