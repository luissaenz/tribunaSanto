---
// Hueco reservado para un módulo futuro (DEP/MET/GRF). Nunca muestra valores.
import { FUTURE_MODULE_NOTICE, type FutureSlot } from '../../presentation/future-modules.js';

interface Props {
  spec: FutureSlot;
}

const { spec: slot } = Astro.props;
const titleId = `slot-${slot.id}`;
---

<section
  class="future-slot"
  aria-labelledby={titleId}
  data-block="future-slot"
  data-module={slot.module}
  data-slot={slot.id}
>
  <div class="future-slot__header">
    <h2 id={titleId} class="future-slot__title">{slot.title}</h2>
    <span class="future-slot__module">{slot.module}</span>
  </div>
  <div class="future-slot__body">
    <p class="future-slot__purpose">{slot.purpose}</p>
    <p class="future-slot__notice">{FUTURE_MODULE_NOTICE[slot.module]}</p>
  </div>
</section>

<style>
  .future-slot {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .future-slot__header {
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    background: var(--color-ink);
    color: var(--color-on-dark);
    border-bottom: 2px solid var(--color-brand);
    padding: var(--space-2) var(--space-4);
  }

  .future-slot__title {
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .future-slot__module {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-on-dark-muted);
    letter-spacing: 0.08em;
  }

  .future-slot__body {
    margin: var(--space-4);
    border: 2px dashed var(--color-border);
    background: var(--color-background);
    padding: var(--space-5) var(--space-4);
    text-align: center;
  }

  .future-slot__purpose {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .future-slot__notice {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-muted);
  }
</style>
