---
import BlockTitle from '../story/BlockTitle.astro';
import StoryCard from '../story/StoryCard.astro';
import type { WebStory } from '../../presentation/story.js';

interface Props {
  stories: readonly WebStory[];
}

const { stories } = Astro.props;
---

<section class="visual-stories" aria-labelledby="visual-title" data-block="visual-stories">
  <BlockTitle title="En imágenes" id="visual-title" compact />
  <ul class="visual-stories__list" role="list">
    {stories.map((story) => (
      <li><StoryCard story={story} variant="feature" level={3} showKicker /></li>
    ))}
  </ul>
</section>

<style>
  .visual-stories__list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  .visual-stories__list > li {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .visual-stories__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
