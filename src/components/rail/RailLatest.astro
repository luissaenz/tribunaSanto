---
import BlockTitle from '../story/BlockTitle.astro';
import StoryCard from '../story/StoryCard.astro';
import type { WebStory } from '../../presentation/story.js';
import { routes } from '../../presentation/routes.js';

interface Props {
  stories: readonly WebStory[];
}

const { stories } = Astro.props;
const [first, ...rest] = stories;
---

<section class="rail-latest" aria-labelledby="rail-latest-title" data-block="rail-latest">
  <BlockTitle title="Últimas" id="rail-latest-title" href={routes.latest()} moreLabel="Todas" compact />
  {first && <StoryCard story={first} variant="feature" level={3} showDek={false} showKicker />}
  <ul role="list">
    {rest.map((story) => (
      <li><StoryCard story={story} variant="thumb" level={3} /></li>
    ))}
  </ul>
</section>

<style>
  .rail-latest ul {
    margin-top: var(--space-4);
  }

  .rail-latest li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }

  .rail-latest li + li {
    margin-top: var(--space-3);
  }

  .rail-latest :global(.card--thumb .card__media) {
    width: var(--thumb-sm-w);
  }

  .rail-latest :global(.card--thumb .card__title) {
    font-size: var(--text-sm);
  }
</style>
