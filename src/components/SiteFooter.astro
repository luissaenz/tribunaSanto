<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand-section">
      <p class="footer-brand">Tribuna Santo</p>
      <p class="footer-desc">
        Medio digital deportivo dedicado a la cobertura periodística, actualidad institucional y memoria de San Martín de Tucumán.
      </p>
      <p class="footer-location">San Miguel de Tucumán · República Argentina</p>
    </div>
    <div class="footer-bottom">
      <p class="footer-notice">
        Primera experiencia editorial visual (WEB.1) alimentada por contratos intermodulares verificados.
      </p>
      <p class="footer-copy">© 2026 Tribuna Santo. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background-color: var(--color-ink);
    color: #d9d5ce;
    border-top: 4px solid var(--color-brand);
    padding: 2.5rem 0 1.5rem;
    font-size: 0.85rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-brand {
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-surface);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .footer-desc {
    max-width: 38rem;
    line-height: 1.6;
    color: #a8a49c;
    margin-bottom: 0.5rem;
  }

  .footer-location {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-bottom {
    border-top: 1px solid #2e2b28;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: #7a7670;
    font-size: 0.75rem;
  }

  @media (min-width: 48rem) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
