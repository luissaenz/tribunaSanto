---
// Tendencias junto al carrusel de portada: miniatura de 96 px, titular y extracto recortados.
import Icon from '../ui/Icon.astro';
import CardImage from '../story/cards/CardImage.astro';
import type { WebStory } from '../../presentation/story.js';
import { routes } from '../../presentation/routes.js';
import { formatCardDate } from '../../presentation/format.js';
import { TRUNCATE, truncateWords } from '../../presentation/text.js';

interface Props {
  stories: readonly WebStory[];
}

const { stories } = Astro.props;
---

<div data-block="trending" class="flex flex-col max-lg:px-4">
  <h2 data-part="title" class="flex items-center gap-2 text-lg font-bold font-heading mb-4 border-s-4 border-black px-4 py-2 bg-red-600">
    <Icon name="fire" class="w-5 h-5 text-white" />
    <span class="text-white">Tendencias</span>
  </h2>
  <div class="space-y-2">
    {
      stories.map((story) => (
        <article class="flex items-start gap-4">
          <div data-part="thumb" class="w-24 flex-none overflow-hidden rounded-sm mt-2">
            <CardImage story={story} class="w-24 h-auto object-cover hover:scale-105 transition-transform duration-300" />
          </div>
          <div>
            <h3 data-part="item-title" class="font-heading text-base md:text-lg font-bold mb-1">
              <a href={routes.article(story)} class="hover:text-red-600 transition-colors">
                {truncateWords(story.article.headline, TRUNCATE.shortTitle)}
              </a>
            </h3>
            {story.article.dek && (
              <p data-part="excerpt" class="text-sm text-gray-600">
                {truncateWords(story.article.dek, TRUNCATE.shortExcerpt)}
              </p>
            )}
            <div class="text-xs text-gray-500 mt-1">{formatCardDate(story.article.publishedAt)}</div>
          </div>
        </article>
      ))
    }
  </div>
</div>
