---
import StoryCard from '../story/StoryCard.astro';
import type { WebStory } from '../../presentation/story.js';

interface Props {
  title: string;
  stories: readonly WebStory[];
}

const { title, stories } = Astro.props;
---

<section class="trending" aria-labelledby="trending-title" data-block="trending">
  <h2 id="trending-title" class="trending__title">{title}</h2>
  <ul class="trending__list" role="list">
    {stories.map((story) => (
      <li><StoryCard story={story} variant="thumb" level={3} /></li>
    ))}
  </ul>
</section>

<style>
  .trending__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #fff;
    background: var(--color-brand);
    border-left: var(--rule-heavy) solid var(--color-ink);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .trending__list > li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
  }
</style>
