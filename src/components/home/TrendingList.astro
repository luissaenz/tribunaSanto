---
import StoryCard from '../story/StoryCard.astro';
import type { WebStory } from '../../presentation/story.js';

interface Props {
  title: string;
  stories: readonly WebStory[];
}

const { title, stories } = Astro.props;
---

<section class="trending" aria-labelledby="trending-title" data-block="trending">
  <h2 id="trending-title" class="trending__title">{title}</h2>
  <ul class="trending__list" role="list">
    {stories.map((story) => (
      <li><StoryCard story={story} variant="thumb" level={3} /></li>
    ))}
  </ul>
</section>

<style>
  /* Rótulo en texto de marca con filete fino debajo; sin bloque de color. */
  .trending__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-brand);
    padding-bottom: var(--space-2);
    border-bottom: var(--hairline) solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .trending__list > li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--color-border-soft);
  }
</style>
