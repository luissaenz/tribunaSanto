<div class="container container--narrow prose" data-block="prose">
  <slot />
</div>

<style>
  .prose {
    padding-block: var(--space-7);
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .prose :global(* + *) {
    margin-top: 1.2em;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.25;
    color: var(--color-ink);
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
  }
</style>
