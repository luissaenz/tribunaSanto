---
// Título de bloque: regla gruesa superior + rótulo invertido y enlace "Ver más" opcional.
interface Props {
  title: string;
  id?: string;
  href?: string;
  moreLabel?: string;
  level?: 1 | 2 | 3;
  compact?: boolean;
}

const { title, id, href, moreLabel = 'Ver más', level = 2, compact = false } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2' | 'h3';
---

<div class:list={['block-title', { 'block-title--compact': compact }]}>
  <Heading class="block-title__label" id={id}>{title}</Heading>
  <slot name="aside" />
  {href && (
    <a class="block-title__more" href={href}>
      {moreLabel}<span class="visually-hidden">: {title}</span> →
    </a>
  )}
</div>
