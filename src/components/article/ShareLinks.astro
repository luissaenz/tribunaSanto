---
// Compartir con enlaces de intención estáticos: sin SDKs ni JavaScript.
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const targets = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { label: 'X', href: `https://x.com/intent/post?url=${u}&text=${t}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'Correo', href: `mailto:?subject=${t}&body=${u}` }
];
---

<section class="share" aria-labelledby="share-title" data-block="share-links">
  <h2 id="share-title" class="share__label">Compartir</h2>
  <ul role="list" class="share__list">
    {targets.map((target) => (
      <li>
        <a class="share__link" href={target.href} rel="noopener noreferrer" target="_blank">
          {target.label}<span class="visually-hidden"> (se abre en otra pestaña)</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: var(--hairline) solid var(--color-border);
  }

  .share__label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-muted);
  }

  .share__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .share__link {
    display: inline-block;
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: 600;
    background: var(--color-surface);
  }

  .share__link:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    text-decoration: none;
  }
</style>
