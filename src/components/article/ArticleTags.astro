---
// Temas del artículo: píldoras con borde de 2 px que se invierten al pasar el puntero.
import { routes } from '../../presentation/routes.js';
import { getTopic, type TopicId } from '../../presentation/taxonomy.js';

interface Props {
  topicIds: readonly TopicId[];
}

const { topicIds } = Astro.props;
---

<div data-block="article-tags" class="flex flex-wrap items-center gap-2 mb-8 pb-8 border-b border-gray-200">
  <span data-part="label" class="text-sm font-bold uppercase text-gray-500 mr-2">Temas:</span>
  {
    topicIds.map((id, i) => (
      <a
        data-part={i === 0 ? 'tag' : undefined}
        href={routes.topic(id)}
        class="text-xs font-bold uppercase px-3 py-1 border-2 border-black hover:bg-black hover:text-white transition-colors"
      >
        {getTopic(id).label}
      </a>
    ))
  }
</div>
