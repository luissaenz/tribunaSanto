---
// Notas relacionadas: grilla 1 / 2 (640 px) / 3 (768 px) con imagen 16:9 centrada, sección y fecha.
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import CardImage from '../story/cards/CardImage.astro';
import type { WebStory } from '../../presentation/story.js';
import { routes } from '../../presentation/routes.js';
import { getSection } from '../../presentation/taxonomy.js';
import { formatCardDate } from '../../presentation/format.js';

interface Props {
  stories: readonly WebStory[];
}

const { stories } = Astro.props;
---

<section data-block="related-articles">
  <SectionHeader title="Notas relacionadas" slot="related" />
  <div data-part="grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    {
      stories.map((story, i) => (
        <article>
          <div data-part={i === 0 ? 'media' : undefined} class="aspect-video overflow-hidden rounded-sm mb-3">
            <CardImage story={story} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
          <span data-part={i === 0 ? 'kicker' : undefined} class="text-xs font-bold text-red-600 uppercase tracking-wider">
            {getSection(story.presentation.sectionId).label.toLowerCase()}
          </span>
          <h3 data-part={i === 0 ? 'title' : undefined} class="font-heading font-bold text-base leading-snug mt-1 mb-1">
            <a href={routes.article(story)} class="hover:text-red-600 transition-colors">
              {story.article.headline}
            </a>
          </h3>
          <div class="text-xs text-gray-500 flex items-center gap-1">
            <Icon name="clock" class="w-3 h-3" />
            {formatCardDate(story.article.publishedAt)}
          </div>
        </article>
      ))
    }
  </div>
</section>
