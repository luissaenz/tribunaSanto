---
import BlockTitle from '../story/BlockTitle.astro';
import StoryCard from '../story/StoryCard.astro';
import type { WebStory } from '../../presentation/story.js';

interface Props {
  stories: readonly WebStory[];
}

const { stories } = Astro.props;
---

<section class="related" aria-labelledby="related-title" data-block="related-stories">
  <BlockTitle title="Notas relacionadas" id="related-title" />
  <ul class="grid grid--3" role="list">
    {stories.map((story) => (
      <li><StoryCard story={story} variant="feature" level={3} showDek={false} showKicker /></li>
    ))}
  </ul>
</section>
