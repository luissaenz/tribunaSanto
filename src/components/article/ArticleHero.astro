---
// Hero del artículo a sangre: 4:3 → 16:9 (768 px) → 16:5 (1024 px), degradado inferior,
// etiqueta de sección con bandera y H1. Sin bajada visible (golden master).
import Icon from '../ui/Icon.astro';
import type { WebStory } from '../../presentation/story.js';
import { routes } from '../../presentation/routes.js';
import { getSection } from '../../presentation/taxonomy.js';

interface Props {
  story: WebStory;
}

const { story } = Astro.props;
const { article, presentation } = story;
const section = getSection(presentation.sectionId);
---

<div data-block="article-hero" class="relative w-full aspect-4/3 md:aspect-video lg:aspect-16/5 overflow-hidden">
  <img
    src={presentation.image.src}
    alt={presentation.image.alt}
    width={presentation.image.width}
    height={presentation.image.height}
    loading="eager"
    class="w-full h-full object-cover"
  />
  <div data-part="overlay" class="absolute inset-0 bg-linear-to-t from-black/95 via-black/60 to-black/20 flex items-end">
    <div class="max-w-7xl mx-auto px-4 w-full pb-10 pt-16">
      <a
        data-part="badge"
        href={routes.section(section.id)}
        class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white mb-4 transition-colors"
      >
        <Icon name="flag" class="w-3.5 h-3.5" />
        {section.label}
      </a>
      <h1 id="titulo-nota" data-part="title" class="font-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight max-w-4xl">
        {article.headline}
      </h1>
    </div>
  </div>
</div>
