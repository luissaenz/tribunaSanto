---
// Cuerpo del artículo con la tipografía editorial `.post-content`.
// Todo el texto se interpola escapado; nunca se inyecta HTML crudo.
import { parseArticleBody } from '../../presentation/article-body.js';

interface Props {
  body: string;
}

const { body } = Astro.props;
const blocks = parseArticleBody(body);
---

<div data-block="article-body" class="post-content max-w-none mb-12">
  {
    blocks.map((block, i) =>
      block.type === 'subheading' ? (
        <h2 id={block.id} data-part={blocks.findIndex((b) => b.type === 'subheading') === i ? 'h2' : undefined}>
          {block.text}
        </h2>
      ) : block.type === 'quote' ? (
        <blockquote data-part={blocks.findIndex((b) => b.type === 'quote') === i ? 'blockquote' : undefined}>
          <p>{block.text}</p>
          {block.attribution && <p>— {block.attribution}</p>}
        </blockquote>
      ) : (
        <p data-part={i === 0 ? 'p' : undefined}>{block.text}</p>
      )
    )
  }
</div>
