---
---

<aside class="sports-sidebar" aria-label="Espacio de datos deportivos">
  <div class="sports-card">
    <div class="card-header">
      <h2 class="card-title">Próximo partido</h2>
    </div>
    <div class="card-body">
      <div class="placeholder-box">
        <span class="placeholder-icon" aria-hidden="true">⚽</span>
        <p class="placeholder-label">Fixture oficial y calendario</p>
        <p class="placeholder-subtext">Datos deportivos disponibles en próximos arcos.</p>
      </div>
    </div>
  </div>

  <div class="sports-card">
    <div class="card-header">
      <h2 class="card-title">Tabla de posiciones</h2>
    </div>
    <div class="card-body">
      <div class="placeholder-box">
        <span class="placeholder-icon" aria-hidden="true">📊</span>
        <p class="placeholder-label">Estadísticas y rendimiento</p>
        <p class="placeholder-subtext">Datos deportivos disponibles en próximos arcos.</p>
      </div>
    </div>
  </div>
</aside>

<style>
  .sports-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .sports-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .card-header {
    background-color: var(--color-ink);
    color: var(--color-surface);
    padding: 0.65rem 1rem;
    border-bottom: 2px solid var(--color-brand);
  }

  .card-title {
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-body {
    padding: 1.25rem 1rem;
  }

  .placeholder-box {
    border: 2px dashed var(--color-border);
    background-color: var(--color-background);
    padding: 1.5rem 1rem;
    text-align: center;
    border-radius: 4px;
  }

  .placeholder-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .placeholder-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .placeholder-subtext {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
