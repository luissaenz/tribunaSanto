---
// Río de notas: imagen 1/3 + texto 2/3 desde 640 px, separadas por filetes.
import Icon from '../ui/Icon.astro';
import CardImage from '../story/cards/CardImage.astro';
import type { WebStory } from '../../presentation/story.js';
import { routes } from '../../presentation/routes.js';
import { getSection } from '../../presentation/taxonomy.js';
import { formatCardDate } from '../../presentation/format.js';

interface Props {
  stories: readonly WebStory[];
  /** Nivel de los titulares: 2 cuando el título del listado es el H1 de la página. */
  level?: 2 | 3;
}

const { stories, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<div data-block="river-list" class="divide-y divide-gray-200">
  {
    stories.map((story, i) => {
      const first = i === 0;
      return (
        <article class="py-6 first:pt-0">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div class="sm:col-span-1 overflow-hidden rounded-sm">
              <CardImage story={story} part={first ? 'media' : undefined} class="w-full h-44 sm:h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="sm:col-span-2 flex flex-col justify-center">
              <span data-part={first ? 'kicker' : undefined} class="text-xs font-bold text-red-600 uppercase tracking-wider mb-2">
                {getSection(story.presentation.sectionId).label.toLowerCase()}
              </span>
              <Heading data-part={first ? 'title' : undefined} class="font-heading text-xl md:text-2xl font-bold mb-2 leading-snug">
                <a href={routes.article(story)} class="hover:text-red-600 transition-colors">
                  {story.article.headline}
                </a>
              </Heading>
              {story.article.dek && (
                <p data-part={first ? 'excerpt' : undefined} class="text-gray-600 text-sm mb-3 leading-relaxed">
                  {story.article.dek}
                </p>
              )}
              <div data-part={first ? 'meta' : undefined} class="flex items-center gap-3 text-xs text-gray-500">
                <span class="flex items-center gap-1">
                  <Icon name="person" class="w-3.5 h-3.5" />
                  {story.article.byline}
                </span>
                <span class="text-gray-300" aria-hidden="true">
                  |
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="clock" class="w-3.5 h-3.5" />
                  {formatCardDate(story.article.publishedAt)}
                </span>
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
