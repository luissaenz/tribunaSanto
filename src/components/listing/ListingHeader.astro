---
interface Props {
  title: string;
  count: number;
  description?: string;
  kicker?: string;
}

const { title, count, description, kicker } = Astro.props;
---

<header class="listing-header" data-block="listing-header">
  <div class="block-title">
    <h1 class="block-title__label listing-header__title">
      {kicker && <span class="visually-hidden">{kicker}: </span>}{title}
    </h1>
    <p class="listing-header__count">{count} {count === 1 ? 'nota' : 'notas'}</p>
  </div>
  {description && <p class="listing-header__desc">{description}</p>}
</header>

<style>
  .listing-header__title {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
  }

  .listing-header__count {
    order: 2;
    font-size: var(--text-sm);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .listing-header__desc {
    margin-top: calc(-1 * var(--space-2));
    color: var(--color-muted);
  }
</style>
