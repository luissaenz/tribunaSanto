---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

<header class="site-header">
  <div class="top-bar">
    <div class="container top-bar-content">
      <span class="edition-label">Edición Digital · San Miguel de Tucumán</span>
      <span class="newspaper-tagline">El medio independiente de La Ciudadela</span>
    </div>
  </div>

  <div class="container brand-container">
    {home ? (
      <h1 class="brand-title">Tribuna Santo</h1>
    ) : (
      <a href="/" class="brand-link" aria-label="Volver a la portada de Tribuna Santo">
        <span class="brand-title-non-h1">Tribuna Santo</span>
      </a>
    )}
    <p class="brand-subtitle">Diario deportivo y actualidad albirroja</p>
  </div>

  <nav class="main-navigation" aria-label="Navegación principal">
    <div class="container nav-content">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Inicio</a></li>
        <li><a href="/#san-martin" class="nav-link">San Martín</a></li>
        <li><a href="/#actualidad" class="nav-link">Actualidad</a></li>
        <li><a href="/#club" class="nav-link">Club</a></li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-brand);
  }

  .top-bar {
    background-color: var(--color-ink);
    color: #e0ded9;
    font-size: 0.75rem;
    padding: 0.35rem 0;
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-container {
    text-align: center;
    padding: 1.5rem 1rem 1rem;
  }

  .brand-title, .brand-title-non-h1 {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-brand);
    line-height: 1;
    margin-bottom: 0.25rem;
    display: inline-block;
  }

  .brand-link {
    text-decoration: none;
  }

  .brand-link:hover .brand-title-non-h1 {
    color: var(--color-brand-dark);
  }

  .brand-subtitle {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-muted);
    font-family: var(--font-serif);
  }

  .main-navigation {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background-color: #faf9f6;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    padding: 0.6rem 0;
    overflow-x: auto;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    padding: 0.2rem 0;
  }

  .nav-link:hover {
    color: var(--color-brand);
    text-decoration: none;
    border-bottom: 2px solid var(--color-brand);
  }

  @media (max-width: 48rem) {
    .top-bar-content {
      flex-direction: column;
      gap: 0.2rem;
      text-align: center;
    }

    .nav-list {
      gap: 1rem;
      justify-content: center;
    }
  }
</style>
