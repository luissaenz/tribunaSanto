---
import type { DemoStory } from '../data/demo-articles.js';

interface Props {
  stories: readonly DemoStory[];
}

const { stories } = Astro.props;

function formatShortTime(isoDate: string) {
  return new Intl.DateTimeFormat('es-AR', {
    timeZone: 'America/Argentina/Buenos_Aires',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(isoDate));
}
---

<section class="latest-news-block" aria-labelledby="latest-news-title">
  <div class="block-header">
    <h2 id="latest-news-title" class="block-title">Últimas noticias</h2>
  </div>
  <ol class="latest-list">
    {stories.map((story) => (
      <li class="latest-item">
        <div class="item-meta">
          <time datetime={story.article.publishedAt} class="item-time">
            {formatShortTime(story.article.publishedAt)}
          </time>
          <span class="meta-sep">·</span>
          <span class="item-tag">{story.presentation.provisionalTag}</span>
        </div>
        <h3 class="item-headline">
          <a href={`/demo/${story.presentation.demoId}/`} class="item-link">
            {story.article.headline}
          </a>
        </h3>
      </li>
    ))}
  </ol>
</section>

<style>
  .latest-news-block {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .block-header {
    background-color: var(--color-ink);
    color: var(--color-surface);
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-brand);
  }

  .block-title {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .latest-list {
    list-style: none;
    padding: 0;
  }

  .latest-item {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .latest-item:last-child {
    border-bottom: none;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.35rem;
  }

  .item-time {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  .meta-sep {
    color: var(--color-border);
    font-size: 0.75rem;
  }

  .item-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .item-headline {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .item-link {
    color: var(--color-ink);
  }

  .item-link:hover {
    color: var(--color-brand);
    text-decoration: none;
  }
</style>
