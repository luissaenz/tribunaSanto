---
import type { DemoStory } from '../data/demo-articles.js';

interface Props {
  story: DemoStory;
}

const { story } = Astro.props;
const { article, presentation } = story;

const formattedDate = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
}).format(new Date(article.publishedAt));

const paragraphs = article.body
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<article class="article-view container">
  <nav class="back-nav" aria-label="Navegación de retorno">
    <a href="/" class="back-link">← Volver a portada</a>
  </nav>

  <header class="article-header">
    <span class="provisional-badge">{presentation.provisionalTag}</span>
    <h1 class="article-headline">{article.headline}</h1>
    {article.dek && <p class="article-dek">{article.dek}</p>}

    <div class="article-meta">
      <span class="byline">Por {article.byline}</span>
      <span class="meta-sep">·</span>
      <time datetime={article.publishedAt} class="editorial-timestamp">{formattedDate}</time>
    </div>
  </header>

  <div class="article-hero-image">
    <img
      src={presentation.image.src}
      alt={presentation.image.alt}
      width="800"
      height="450"
      class="hero-img"
    />
    <p class="image-caption">{presentation.image.alt}</p>
  </div>

  <div class="article-body">
    {paragraphs.map((paragraph) => (
      <p class="article-paragraph">{paragraph}</p>
    ))}
  </div>

  <footer class="article-footer">
    <div class="return-box">
      <a href="/" class="back-link-bottom">← Volver a la portada de Tribuna Santo</a>
    </div>
  </footer>
</article>

<style>
  .article-view {
    max-width: 52rem;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link, .back-link-bottom {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-headline {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0.5rem 0 1rem;
  }

  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .article-meta {
    font-size: 0.85rem;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }

  .article-hero-image {
    margin-bottom: 2.5rem;
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background-color: #000;
    border: 1px solid var(--color-border);
  }

  .image-caption {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .article-body {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.75;
    color: #1a1a1a;
  }

  .article-paragraph {
    margin-bottom: 1.5rem;
  }

  .article-footer {
    margin-top: 3rem;
    border-top: 2px solid var(--color-brand);
    padding-top: 1.5rem;
  }

  .return-box {
    text-align: center;
    padding: 1rem 0;
  }
</style>
