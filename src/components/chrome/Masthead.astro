---
// Cabecera con logo, nombre y lema. En portada el nombre es el único H1 (D3),
// con las mismas clases visuales que en el resto de las páginas.
import { siteChrome } from '../../data/demo-chrome.js';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const Name = home ? 'h1' : 'span';
---

<div data-block="masthead" class="max-w-7xl mx-auto px-4 py-6">
  <div class="text-center">
    <a href="/">
      <div class="inline-flex items-center gap-3 mb-2">
        <img
          data-part="logo"
          src={siteChrome.logo.src}
          alt={siteChrome.logo.alt}
          width={siteChrome.logo.width}
          height={siteChrome.logo.height}
          class="size-8 md:size-12 rounded-sm"
        />
        <Name data-part="name" class="font-heading font-bold text-black text-4xl md:text-5xl lg:text-6xl">{siteChrome.name}</Name>
      </div>
    </a>
    <p data-part="tagline" class="text-sm sm:text-base md:text-lg font-medium text-gray-600">{siteChrome.tagline}</p>
  </div>
</div>
