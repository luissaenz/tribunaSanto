---
import { formatEditionDate } from '../../presentation/format.js';

interface Props {
  editionInstant: string;
}

const { editionInstant } = Astro.props;
---

<div class="utility-bar" data-block="utility-bar">
  <div class="container utility-bar__content">
    <p>
      <span class="visually-hidden">Edición del </span>
      <time datetime={editionInstant} class="utility-bar__date">{formatEditionDate(editionInstant)}</time>
    </p>
    <p class="utility-bar__place">San Miguel de Tucumán · Edición digital</p>
  </div>
</div>

<style>
  .utility-bar {
    background: var(--color-ink);
    color: var(--color-on-dark-muted);
    font-size: var(--text-xs);
    padding-block: var(--space-2);
  }

  .utility-bar__content {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .utility-bar__date {
    text-transform: capitalize;
  }

  @media (max-width: 39.99rem) {
    .utility-bar__place {
      display: none;
    }
  }
</style>
