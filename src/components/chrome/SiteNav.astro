---
// Navegación principal: sticky, links en mayúsculas desde 1024 px,
// hamburguesa con panel absoluto por debajo de 1024 px y búsqueda desplegable.
// La búsqueda navega a /demo/ultimas/?q= (DESVIACIÓN DEMO TEMPORAL: sin
// golden master de /search). Estado en src/scripts/alpine.ts (siteNav).
import Icon from '../ui/Icon.astro';
import { routes } from '../../presentation/routes.js';
import { getSection, NAV_SECTION_ORDER, type SectionId } from '../../presentation/taxonomy.js';
import { SEARCH_ACTION } from '../../scripts/interactions/nav.js';

interface Props {
  current?: SectionId | 'home';
}

const { current } = Astro.props;
const items = [
  { id: 'home', label: 'Inicio', href: routes.home() },
  ...NAV_SECTION_ORDER.map((id) => ({ id, label: getSection(id).label, href: routes.section(id) }))
];
---

<nav data-block="site-nav" class="sticky top-0 z-50 bg-black text-white" aria-label="Navegación principal" x-data="siteNav" @keydown.escape.window="closeAll()">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between py-3">
        <div data-part="links" class="hidden lg:flex gap-8 uppercase">
          {
            items.map((item) => (
              <a
                href={item.href}
                class:list={['font-medium hover:text-red-500 transition-colors', { 'text-red-500': item.id === current }]}
                aria-current={item.id === current ? 'page' : undefined}
                data-part={item.id === current ? 'link-active' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <div class="max-lg:w-full flex items-center justify-between gap-4">
          <button
            type="button"
            data-part="menu-toggle"
            class="lg:hidden"
            aria-label="Abrir o cerrar menú"
            aria-controls="menu-mobile"
            aria-expanded="false"
            :aria-expanded="menuOpen.toString()"
            @click="toggleMenu()"
          >
            <Icon name="list" class="w-7 h-7" x-show="!menuOpen" />
            <Icon name="x-lg" class="w-6 h-6" x-show="menuOpen" x-cloak="" />
          </button>
          <button
            type="button"
            data-part="search-toggle"
            class="hover:text-gray-300 transition-colors"
            aria-label="Buscar"
            aria-controls="busqueda"
            aria-expanded="false"
            :aria-expanded="searchOpen.toString()"
            @click="toggleSearch()"
          >
            <Icon name="search" class="w-6 h-6" x-show="!searchOpen" />
            <Icon name="x-lg" class="w-5 h-5" x-show="searchOpen" x-cloak="" />
          </button>
        </div>
      </div>
      <div id="busqueda" data-part="search-bar" class="pb-4" x-show="searchOpen" x-transition="" x-cloak="">
        <form role="search" class="flex" action={SEARCH_ACTION} method="get" @submit.prevent="submitSearch()">
          <input
            x-ref="searchInput"
            x-model="q"
            name="q"
            type="text"
            placeholder="Buscar noticias..."
            aria-label="Buscar noticias"
            class="flex-1 px-4 py-2 text-black bg-white focus:outline-none"
          />
          <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 transition-colors" aria-label="Enviar búsqueda">
            <Icon name="search" class="w-4 h-4" />
          </button>
        </form>
      </div>
    </div>
    <div
      id="menu-mobile"
      data-part="menu"
      class="absolute top-full inset-x-0 bg-black px-4 pt-3 lg:hidden pb-12 z-50 max-h-[90vh] overflow-y-auto scrollbars"
      x-show="menuOpen"
      x-transition=""
      x-cloak=""
      @click.outside="closeMenu()"
    >
      <div class="flex flex-col uppercase">
        {
          items.map((item) => (
            <a
              href={item.href}
              class:list={['py-2 font-medium hover:text-red-500 transition-colors border-b border-white/10', { 'text-red-500': item.id === current }]}
              aria-current={item.id === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>
