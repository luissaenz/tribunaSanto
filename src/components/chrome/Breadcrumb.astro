---
export type Crumb = Readonly<{ label: string; href?: string }>;

interface Props {
  items: readonly Crumb[];
  narrow?: boolean;
}

const { items, narrow = false } = Astro.props;
const trail: readonly Crumb[] = [{ label: 'Inicio', href: '/' }, ...items];
---

<nav class="breadcrumb" aria-label="Ruta de navegación" data-block="breadcrumb">
  <ol class:list={['container', 'breadcrumb__list', { 'container--narrow': narrow }]} role="list">
    {trail.map((crumb, i) => (
      <li class="breadcrumb__item">
        {crumb.href && i < trail.length - 1 ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span aria-current="page">{crumb.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .breadcrumb__item + .breadcrumb__item::before {
    content: '›';
    margin-right: var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb__item {
    min-width: 0;
    max-width: 100%;
  }

  .breadcrumb__item a {
    font-weight: 600;
  }

  .breadcrumb__item a:hover {
    color: var(--color-brand);
  }

  .breadcrumb__item [aria-current] {
    color: var(--color-ink);
    font-weight: 700;
    display: inline-block;
    max-width: min(40ch, 100%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
</style>
