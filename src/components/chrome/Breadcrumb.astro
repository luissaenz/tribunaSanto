---
// Migas de pan: banda gris con chevrons; variante angosta (max-w-4xl) en páginas legales.
import Icon from '../ui/Icon.astro';
import { TRUNCATE, truncateWords } from '../../presentation/text.js';

export type Crumb = Readonly<{ label: string; href?: string }>;

interface Props {
  items: readonly Crumb[];
  narrow?: boolean;
}

const { items, narrow = false } = Astro.props;
const trail: readonly Crumb[] = [{ label: 'Inicio', href: '/' }, ...items];
---

<div data-block="breadcrumb" class="bg-gray-100 border-b border-gray-200">
  <nav
    data-part="inner"
    aria-label="Ruta de navegación"
    class:list={[narrow ? 'max-w-4xl' : 'max-w-7xl', 'mx-auto px-4 py-3 flex items-center gap-2 text-sm text-gray-500 flex-wrap']}
  >
    {
      trail.map((crumb, i) =>
        crumb.href && i < trail.length - 1 ? (
          <>
            <a href={crumb.href} data-part={i === 0 ? 'link' : undefined} class:list={['hover:text-red-600 font-medium transition-colors', { capitalize: i > 0 }]}>
              {crumb.label}
            </a>
            <Icon name="chevron-right" class="w-3 h-3 text-gray-400 flex-none" />
          </>
        ) : (
          <span data-part="current" aria-current="page" class="text-black font-semibold" title={crumb.label}>
            {truncateWords(crumb.label, TRUNCATE.breadcrumb)}
          </span>
        )
      )
    }
  </nav>
</div>
