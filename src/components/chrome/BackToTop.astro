---
// Botón fijo "volver arriba": visible pasados 400 px de scroll, desplazamiento suave.
import Icon from '../ui/Icon.astro';
---

<button
  type="button"
  data-block="back-to-top"
  class="fixed bottom-6 right-6 z-50 w-10 h-10 bg-red-600 hover:bg-red-700 text-white flex items-center justify-center rounded-sm transition-colors shadow-lg"
  aria-label="Volver arriba"
  x-data="backToTop"
  x-show="show"
  x-transition=""
  x-cloak=""
  @scroll.window="onScroll()"
  @click="toTop()"
>
  <Icon name="arrow-up" class="w-5 h-5" />
</button>
