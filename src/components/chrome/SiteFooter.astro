---
// Pie: marca + redes, columnas de secciones e institucional, newsletter (no-op DEMO) y copyright.
import Icon from '../ui/Icon.astro';
import { siteChrome } from '../../data/demo-chrome.js';
import { routes } from '../../presentation/routes.js';
import { FOOTER_SECTION_ORDER, getSection } from '../../presentation/taxonomy.js';

const { footer, socials, footerPages: pages } = siteChrome;
---

<footer data-block="site-footer" class="bg-black text-white pt-16">
  <div class="max-w-7xl mx-auto px-4">
    <div data-part="grid" class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div>
        <h2 data-part="brand-title" class="font-heading text-2xl font-bold mb-4">{footer.title}</h2>
        <p class="text-gray-300 text-sm mb-6">{footer.description}</p>
        <div class="flex gap-4">
          {
            socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (demo)`} class="text-gray-300 hover:text-white transition-colors">
                <Icon name={s.network} class="w-6 h-6" />
              </a>
            ))
          }
        </div>
      </div>
      <nav class="grid grid-cols-2 gap-2" aria-label="Enlaces del sitio">
        <div>
          <h3 class="font-bold uppercase mb-4">{footer.categoriesTitle}</h3>
          <ul class="space-y-2 text-sm">
            {
              FOOTER_SECTION_ORDER.map((id) => (
                <li>
                  <a href={routes.section(id)} class="text-gray-300 hover:text-white transition-colors">
                    {getSection(id).label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-bold uppercase mb-4">{footer.pagesTitle}</h3>
          <ul class="space-y-2 text-sm">
            {
              pages.map((p) => (
                <li>
                  <a href={p.href} class="text-gray-300 hover:text-white transition-colors">
                    {p.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
      <div>
        <h3 class="font-heading text-xl font-bold mb-2">{footer.newsletterTitle}</h3>
        <p class="text-sm text-gray-400 mb-6">{footer.newsletterLead}</p>
        <form x-data="newsletter" @submit.prevent="submit()">
          <input
            data-part="newsletter-input"
            type="email"
            placeholder={footer.newsletterPlaceholder}
            aria-label={footer.newsletterPlaceholder}
            class="w-full px-3 py-2 border border-gray-600 bg-transparent mb-3 text-white placeholder-gray-400 focus:outline-none focus:border-red-600 transition-colors"
          />
          <button data-part="newsletter-button" type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white py-2 font-bold uppercase transition-colors">
            {footer.newsletterButton}
          </button>
        </form>
      </div>
    </div>
    <div data-part="copyright" class="border-t border-gray-800 py-8 text-center text-sm text-gray-400">
      <p>{footer.copyright}</p>
    </div>
  </div>
</footer>
