---
import { sections } from '../../presentation/taxonomy.js';
import { routes } from '../../presentation/routes.js';
---

<footer class="site-footer" data-block="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__name">Tribuna Santo</p>
        <p class="site-footer__desc">
          Medio digital deportivo dedicado a la cobertura periodística, actualidad institucional y memoria de San Martín de Tucumán.
        </p>
        <p class="site-footer__place">San Miguel de Tucumán · República Argentina</p>
      </div>

      <nav class="site-footer__columns" aria-label="Enlaces del sitio">
        <div>
          <h2 class="site-footer__heading">Secciones</h2>
          <ul role="list">
            {sections.map((s) => (
              <li><a href={routes.section(s.id)}>{s.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__heading">Tribuna Santo</h2>
          <ul role="list">
            <li><a href={routes.latest()}>Últimas noticias</a></li>
            <li><a href={routes.about()}>Acerca del proyecto</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>Experiencia editorial WEB.2 alimentada por contratos intermodulares verificados. Contenido de demostración ficticio.</p>
      <p>© 2026 Tribuna Santo · <a href="#top">Volver arriba ↑</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-ink);
    color: var(--color-on-dark-muted);
    border-top: 4px solid var(--color-brand);
    padding-top: var(--space-8);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-on-dark);
    margin-bottom: var(--space-3);
  }

  .site-footer__desc {
    max-width: 34rem;
    line-height: 1.6;
  }

  .site-footer__place {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .site-footer__heading {
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-dark);
    margin-bottom: var(--space-3);
  }

  .site-footer__columns li + li {
    margin-top: var(--space-2);
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer__bottom {
    border-top: 1px solid #2e2b28;
    padding-block: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: #8a857d;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
