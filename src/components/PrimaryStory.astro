---
import type { DemoStory } from '../data/demo-articles.js';

interface Props {
  story: DemoStory;
}

const { story } = Astro.props;
const { article, presentation } = story;

const formattedDate = new Intl.DateTimeFormat('es-AR', {
  timeZone: 'America/Argentina/Buenos_Aires',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
}).format(new Date(article.publishedAt));
---

<article class="primary-story">
  <div class="primary-image-wrapper">
    <a href={`/demo/${presentation.demoId}/`} tabindex="-1" aria-hidden="true">
      <img
        src={presentation.image.src}
        alt={presentation.image.alt}
        width="800"
        height="450"
        class="primary-image"
      />
    </a>
  </div>
  <div class="primary-content">
    <span class="provisional-badge">{presentation.provisionalTag}</span>
    <h2 class="primary-headline">
      <a href={`/demo/${presentation.demoId}/`} class="headline-link">
        {article.headline}
      </a>
    </h2>
    {article.dek && <p class="primary-dek">{article.dek}</p>}
    <div class="primary-meta">
      <span class="byline">Por {article.byline}</span>
      <span class="meta-sep">·</span>
      <time datetime={article.publishedAt} class="editorial-timestamp">{formattedDate}</time>
    </div>
  </div>
</article>

<style>
  .primary-story {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .primary-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #000;
  }

  .primary-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .primary-content {
    padding: 1.5rem;
  }

  .primary-headline {
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0.35rem 0 0.85rem;
  }

  .headline-link {
    color: var(--color-ink);
  }

  .headline-link:hover {
    color: var(--color-brand);
    text-decoration: none;
  }

  .primary-dek {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.5;
    color: #33312e;
    margin-bottom: 1rem;
  }

  .primary-meta {
    font-size: 0.85rem;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .meta-sep {
    color: var(--color-border);
  }

  @media (min-width: 48rem) {
    .primary-content {
      padding: 2rem;
    }
  }
</style>
