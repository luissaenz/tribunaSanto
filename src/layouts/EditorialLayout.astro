---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
}

const {
  title,
  description = 'Tribuna Santo — actualidad y cultura alrededor de San Martín de Tucumán',
  home = false
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <SiteHeader home={home} />
    <slot />
    <SiteFooter />
  </body>
</html>
