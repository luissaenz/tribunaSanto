---
// Layout base de la web demo (WEB.2).
//
// Todas las páginas de WEB.2 contienen exclusivamente contenido ficticio y
// rutas provisionales: se emiten siempre como `noindex, nofollow` y sin
// canonical, OpenGraph ni Twitter Cards. No existe prop para habilitar la
// indexación; esa decisión corresponde a un ciclo SEO futuro.
import { Font } from 'astro:assets';
import '../styles/global.css';
import UtilityBar from '../components/chrome/UtilityBar.astro';
import Masthead from '../components/chrome/Masthead.astro';
import PrimaryNav from '../components/chrome/PrimaryNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import type { SectionId } from '../presentation/taxonomy.js';

interface Props {
  title: string;
  description: string;
  editionInstant: string;
  home?: boolean;
  current?: SectionId | 'home' | 'latest';
}

const { title, description, editionInstant, home = false, current } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-pt-serif" preload />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body id="top">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <UtilityBar editionInstant={editionInstant} />
      <Masthead home={home} />
    </header>
    <PrimaryNav current={current} />
    <main id="contenido" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/alpine.ts';
    </script>
  </body>
</html>

<style>
  .site-main {
    padding-bottom: var(--space-8);
  }
</style>
