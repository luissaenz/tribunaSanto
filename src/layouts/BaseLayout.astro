---
import '../styles/global.css';
import UtilityBar from '../components/chrome/UtilityBar.astro';
import Masthead from '../components/chrome/Masthead.astro';
import PrimaryNav from '../components/chrome/PrimaryNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { site } from '../presentation/site.js';
import type { SectionId } from '../presentation/taxonomy.js';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  current?: SectionId | 'home' | 'latest';
  ogType?: 'website' | 'article';
  image?: string;
}

const {
  title,
  description,
  home = false,
  current,
  ogType = 'website',
  image
} = Astro.props;

if (!Astro.site) {
  throw new Error('astro.config.mjs must define `site` to build absolute canonicals');
}

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Tribuna Santo" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body id="top">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <UtilityBar editionInstant={site.editionInstant} />
      <Masthead home={home} />
    </header>
    <PrimaryNav current={current} />
    <slot name="before-main" />
    <main id="contenido" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .site-main {
    padding-bottom: var(--space-8);
  }
</style>
