{
  "name": "tribuna-santo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "corpus:inventory": "tsx scripts/corpus/inventory.ts",
    "seo:policy": "tsx scripts/seo/check-policy.ts",
    "seo:jsonld": "tsx scripts/seo/check-jsonld.ts",
    "seo:sitemaps": "tsx scripts/seo/check-sitemaps.ts",
    "seo:links": "tsx scripts/seo/check-links.ts",
    "seo:gate": "npm run seo:policy && npm run seo:jsonld && npm run seo:sitemaps && npm run seo:links",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run seo:gate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "docker compose exec postgres pg_isready -U tribuna_santo -d tribuna_santo"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.11.2",
    "node-html-parser": "^9.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
